package block

import (
	"fantacode/ecomm/internal/app/ui/components/button"
	"fantacode/ecomm/internal/app/ui/components/icon"
)

type LangSwitcherProps struct {
	Class string
}

templ LangSwitcher(props ...LangSwitcherProps) {
	{{ var p LangSwitcherProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		class="relative inline-block"
		_="on click from elsewhere add .hidden to <div[data-lang-menu]/> in me
			on keyup[key is 'Escape'] from elsewhere add .hidden to <div[data-lang-menu]/> in me"
	>
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   p.Class,
			Attributes: templ.Attributes{
				"aria-haspopup": "menu",
				"_":             "on click halt the event then toggle .hidden on the next <div/>",
			},
		}) {
			@icon.Languages(icon.Props{Class: "size-5"})
		}
		<div
			data-lang-menu
			class="hidden absolute right-0 mt-2 min-w-32 rounded-md bg-popover p-1 shadow-md border border-border"
			role="menu"
		>
			<button
				type="button"
				class="w-full text-left flex items-center justify-between px-2 py-1.5 text-sm rounded-sm focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default"
				role="menuitem"
				_="on click
					set cookies['LANGUAGE'] to {value: 'zh', path: '/', maxAge: 31536000, sameSite: 'Lax'}
					reload() the location of the window"
			>
				中文 - 简体
			</button>
			<button
				type="button"
				class="w-full text-left flex items-center justify-between px-2 py-1.5 text-sm rounded-sm focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default"
				role="menuitem"
				_="on click
					set cookies['LANGUAGE'] to {value: 'zh-Hant', path: '/', maxAge: 31536000, sameSite: 'Lax'}
					reload() the location of the window"
			>
				中文 - 繁體
			</button>
			<button
				type="button"
				class="w-full text-left flex items-center justify-between px-2 py-1.5 text-sm rounded-sm focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default"
				role="menuitem"
				_="on click
					set cookies['LANGUAGE'] to {value: 'en', path: '/', maxAge: 31536000, sameSite: 'Lax'}
					reload() the location of the window"
			>
				English
			</button>
		</div>
	</div>
}
