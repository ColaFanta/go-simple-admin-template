package misc

import (
	l10n "fantacode/ecomm/internal/app/server/middleware"
	"fantacode/ecomm/internal/app/server/ui/components/button"
	"fantacode/ecomm/internal/app/server/ui/layout"
	opera "github.com/colafanta/go-opera"
	"github.com/gofiber/fiber/v3"
	"github.com/nicksnyder/go-i18n/v2/i18n"
)

templ LandingPage(c fiber.Ctx) {
	{{ t := fiber.Locals[*i18n.Localizer](c, l10n.KeyI18nLocalizer) }}
	@layout.LandingLayout() {
		<div class="h-full flex justify-center items-center">
			<div class="flex flex-col gap-4 items-center justify-center px-4 w-full max-w-2xl">
				<div class="text-center space-y-4">
					<h1 class="text-5xl font-bold tracking-tight">{ opera.Must(t.LocalizeMessage(&i18n.Message{ID: "FantaAdmin"})) }</h1>
					<p class="text-muted-foreground text-lg max-w-md mx-auto">
						{ opera.Must(t.LocalizeMessage(&i18n.Message{ID: "AdminPanelDesc"})) }
						<br/>
						{ opera.Must(t.LocalizeMessage(&i18n.Message{ID: "GolangFiber"})) }
					</p>
				</div>
				<div hx-boost="true" hx-indicator="#gprogress" class="flex gap-3">
					@button.Button(button.Props{
						Variant: "default",
						Href:    "/login",
					}) {
						{ opera.Must(t.LocalizeMessage(&i18n.Message{ID: "Login"})) }
					}
					@button.Button(button.Props{
						Variant: "outline",
						Href:    "/signup",
					}) {
						{ opera.Must(t.LocalizeMessage(&i18n.Message{ID: "SignUp"})) }
					}
				</div>
			</div>
		</div>
	}
}
