package product

import (
	"fantacode/ecomm/internal/admsvr/router/api/apicm"
	"fantacode/ecomm/internal/admsvr/ui/block"
	"fantacode/ecomm/internal/admsvr/ui/components/badge"
	"fantacode/ecomm/internal/admsvr/ui/components/button"
	"fantacode/ecomm/internal/admsvr/ui/components/card"
	"fantacode/ecomm/internal/admsvr/ui/components/form"
	"fantacode/ecomm/internal/admsvr/ui/components/icon"
	"fantacode/ecomm/internal/admsvr/ui/components/input"
	"fantacode/ecomm/internal/admsvr/ui/components/table"
	"fantacode/ecomm/internal/admsvr/ui/components/tabs"
	"fantacode/ecomm/internal/biz/dao/model"
	"fantacode/ecomm/internal/biz/l10n"
	"fantacode/ecomm/internal/gorm/gormq"
	"fmt"
	. "github.com/colafanta/go-opera"
	"github.com/gofiber/fiber/v3"
	"github.com/nicksnyder/go-i18n/v2/i18n"
	"github.com/samber/lo"
	"net/url"
	"strings"
)

templ SkuTableLayout(c fiber.Ctx) {
	{{ t := fiber.Locals[*i18n.Localizer](c, l10n.KeyI18nLocalizer) }}
	@apicm.AdminLayout(c) {
		<h1 class="text-2xl font-semibold py-3">{ Must(t.LocalizeMessage(&i18n.Message{ID: "SKUManagement"})) }</h1>
		<div class="w-full my-0.5 flex items-center justify-between gap-3">
			<form id="filters" hx-boost="true" hx-target="#data-table" action="" class="max-w-lg">
				@form.Item() {
					@form.Label(form.LabelProps{For: "search"}) {
						{ Must(t.LocalizeMessage(&i18n.Message{ID: "SearchSKU"})) }
					}
					@form.ItemFlex(form.ItemProps{Class: "w-full"}) {
						<div class="flex-1">
							@input.Input(input.Props{ID: "search", Type: input.TypeSearch, Name: "search", Value: c.Query("search"), Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "SkuContains"}))})
						</div>
						@button.Button(button.Props{Size: button.SizeIcon, Variant: button.VariantSecondary, Type: button.TypeSubmit}) {
							@icon.Search()
						}
					}
				}
				<input type="hidden" name="product_id" value={ c.Query("product_id") }/>
				<input id="page_no" type="hidden" name="_page" value={ MaybeEmpty(c.Query("_page")).Or("1") }/>
			</form>
			<div class="flex items-center gap-2">
				@button.Button(button.Props{Size: button.SizeIcon, Variant: button.VariantSecondary, Href: apicm.ApiBasePath + "/skus/create?product_id=" + url.QueryEscape(c.Query("product_id"))}) {
					@icon.Plus()
				}
			</div>
		</div>
		<div id="data-table" class="mt-6">
			{ children... }
		</div>
	}
}

templ SkuTable(c fiber.Ctx) {
	{{
		res := fiber.Locals[gormq.GetListResponse[model.Sku]](c, keySkuTableData)
		data := res.Data
		t := fiber.Locals[*i18n.Localizer](c, l10n.KeyI18nLocalizer)
	}}
	@table.Table() {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "SKU"})) }
				}
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "Product"})) }
				}
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "Spec"})) }
				}
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "Prices"})) }
				}
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "TotalInventory"})) }
				}
				@table.Head() {
					{ Must(t.LocalizeMessage(&i18n.Message{ID: "Actions"})) }
				}
			}
		}
		@table.Body() {
			for _, d := range data {
				@table.Row() {
					@table.Cell() {
						{ d.SkuCode }
					}
					@table.Cell() {
						<div class="space-y-1">
							<div class="font-medium">{ d.Product.Name }</div>
							<div class="text-xs text-muted-foreground">{ fmt.Sprintf("#%d", d.ProductID) } · { d.Product.Category }</div>
						</div>
					}
					@table.Cell() {
						if d.SkuSpecPhone != nil {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "Phone"})) }
							}
							<div class="mt-1 text-xs text-muted-foreground">
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "CPU"})) } { d.SkuSpecPhone.Processor } · { fmt.Sprintf("%dGB", d.SkuSpecPhone.Storage) } · { d.SkuSpecPhone.Color }
							</div>
							<div class="text-xs text-muted-foreground">
								{ d.SkuSpecPhone.Currency } { fmt.Sprintf("%.2f", float64(d.SkuSpecPhone.BasePrice)/100.0) }
							</div>
						} else if d.SkuSpecPc != nil {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "PC"})) }
							}
							<div class="mt-1 text-xs text-muted-foreground">
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "CPU"})) } { d.SkuSpecPc.Processor } · { Must(t.LocalizeMessage(&i18n.Message{ID: "RAMShort"})) } { fmt.Sprintf("%dGB", d.SkuSpecPc.Ram) } · { fmt.Sprintf("%dGB", d.SkuSpecPc.Storage) }
							</div>
							<div class="text-xs text-muted-foreground">
								{ d.SkuSpecPc.Currency } { fmt.Sprintf("%.2f", float64(d.SkuSpecPc.BasePrice)/100.0) }
							</div>
						} else {
							<span class="text-muted-foreground">-</span>
						}
					}
					@table.Cell() {
						if len(d.Prices) == 0 {
							<span class="text-muted-foreground">-</span>
						} else {
							<div class="space-y-1">
								for _, p := range d.Prices {
									<div class="text-xs">
										{ p.Currency }: { fmt.Sprintf("%.2f", float64(p.Price)/100.0) }
									</div>
								}
							</div>
						}
					}
					@table.Cell() {
						<a class="underline" href={ apicm.ApiBasePath + "/inventories?sku_id=" + fmt.Sprintf("%d", d.ID) }>
							{ fmt.Sprintf("%d", len(d.Inventories)) }
						</a>
					}
					@table.Cell() {
						@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Href: apicm.ApiBasePath + "/skus/" + fmt.Sprintf("%d", d.ID)}) {
							@icon.PenLine()
						}
						@button.Button(button.Props{Variant: button.VariantDestructive, Size: button.SizeIcon, Attributes: templ.Attributes{
							"hx-delete":  apicm.ApiBasePath + "/skus/" + url.PathEscape(fmt.Sprintf("%d", d.ID)),
							"hx-confirm": Must(t.LocalizeMessage(&i18n.Message{ID: "SureToDelete"})),
							"hx-target":  "closest tr",
							"hx-swap":    "delete",
						}}) {
							@icon.Trash()
						}
					}
				}
			}
		}
	}
	{{ curr, total := res.Page, res.Total/res.Size+lo.Ternary(res.Total%res.Size > 0, 1, 0) }}
	@block.Pagination(block.PaginationProps{CurrentPage: curr, TotalPages: total})
}

templ SkuCuForm(c fiber.Ctx) {
	{{
		s := fiber.Locals[model.Sku](c, skuDetailDataKey)
		isEditing := s.ID != 0
		productID := MaybeEmpty(c.Query("product_id")).Or(lo.Ternary(s.ProductID != 0, fmt.Sprintf("%d", s.ProductID), ""))
		specType := MaybeEmpty(c.Query("spec_type")).Or(lo.Ternary(s.SkuSpecPhone != nil, "phone", lo.Ternary(s.SkuSpecPc != nil, "pc", "")))
		prices := s.Prices
		if len(prices) == 0 {
			prices = []model.SkuPrice{{}}
		}
		basePrice := ""
		currency := ""
		phoneProcessor, phoneColor, phoneSize, phoneCamera := "", "", "", ""
		phoneStorage := ""
		pcProcessor := ""
		pcRam := ""
		pcStorage := ""
		if s.SkuSpecPhone != nil {
			basePrice = fmt.Sprintf("%d", s.SkuSpecPhone.BasePrice)
			currency = s.SkuSpecPhone.Currency
			phoneProcessor = s.SkuSpecPhone.Processor
			phoneStorage = fmt.Sprintf("%d", s.SkuSpecPhone.Storage)
			phoneColor = s.SkuSpecPhone.Color
			phoneSize = s.SkuSpecPhone.Size
			phoneCamera = s.SkuSpecPhone.Camera
		}
		if s.SkuSpecPc != nil {
			basePrice = fmt.Sprintf("%d", s.SkuSpecPc.BasePrice)
			currency = s.SkuSpecPc.Currency
			pcProcessor = s.SkuSpecPc.Processor
			pcRam = fmt.Sprintf("%d", s.SkuSpecPc.Ram)
			pcStorage = fmt.Sprintf("%d", s.SkuSpecPc.Storage)
		}
		t := fiber.Locals[*i18n.Localizer](c, l10n.KeyI18nLocalizer)
		skuSavedMsg := strings.ReplaceAll(Must(t.LocalizeMessage(&i18n.Message{ID: "SKUSaved"})), "'", "\\'")
		skuCuFormHs := fmt.Sprintf(`on submit
																	set currencies to []
																	set amounts to []
																	for curEl in <[data-price-currency]/> in #prices-rows
																		set cur to curEl's value
																		set cur to '' if cur is null
																		set cur to cur.trim().toUpperCase()
																		call currencies.push(cur)
																	end
																	for amtEl in <[data-price-amount]/> in #prices-rows
																		set amtRaw to amtEl's value
																		set amtRaw to '' if amtRaw is null
																		set amtRaw to amtRaw.trim()
																		call amounts.push(amtRaw)
																	end
																	set #prices_currencies.value to currencies.join(',')
																	set #prices_amounts.value to amounts.join(',')
																end
																on htmx:afterRequest
																	if event.detail.successful then
																		alert('%s')
																		set window.location.href to '.'
																	end`, skuSavedMsg)
	}}
	@apicm.AdminLayout(c) {
		<h1 class="text-2xl font-semibold py-3">{ Must(t.LocalizeMessage(&i18n.Message{ID: "SKU"})) }</h1>
		<div class="mt-2 flex px-4 pb-10">
			@card.Card(card.Props{Class: "w-full max-w-2xl"}) {
				@card.Header() {
					@card.Title() {
						if isEditing {
							{ Must(t.LocalizeMessage(&i18n.Message{ID: "EditSKU"})) }
						} else {
							{ Must(t.LocalizeMessage(&i18n.Message{ID: "CreateSKU"})) }
						}
					}
				}
				@card.Content() {
					<form
						id="sku-cu-form"
						hx-put={ apicm.ApiBasePath + "/skus" }
						hx-swap="none"
						_={ skuCuFormHs }
					>
						<input type="hidden" name="id" value={ lo.Ternary(isEditing, fmt.Sprintf("%d", s.ID), "") }/>
						<input type="hidden" id="prices_currencies" name="prices_currencies" value=""/>
						<input type="hidden" id="prices_amounts" name="prices_amounts" value=""/>
						@form.Item() {
							@form.Label(form.LabelProps{For: "product_id"}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "ProductID"})) }
							}
							@input.Input(input.Props{ID: "product_id", Name: "product_id", Value: productID, Attributes: templ.Attributes{"required": true, "type": "number"}})
						}
						<div class="my-4"></div>
						@form.Item() {
							@form.Label(form.LabelProps{For: "sku_code"}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "SKUCode"})) }
							}
							@input.Input(input.Props{ID: "sku_code", Name: "sku_code", Value: s.SkuCode, Attributes: templ.Attributes{"required": true}})
						}
						<div class="my-4"></div>
						@form.Item() {
							@form.Label(form.LabelProps{For: "spec_type"}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "SpecType"})) }
							}
							@input.Input(input.Props{ID: "spec_type", Name: "spec_type", Value: specType, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "PhonePc"})), Attributes: templ.Attributes{"required": true}})
						}
						<div class="my-4"></div>
						@form.Item() {
							@form.Label(form.LabelProps{For: "base_price"}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "BasePrice"})) }
							}
							@input.Input(input.Props{ID: "base_price", Name: "base_price", Value: basePrice, Attributes: templ.Attributes{"required": true, "type": "number"}})
						}
						<div class="my-4"></div>
						@form.Item() {
							@form.Label(form.LabelProps{For: "currency"}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "Currency"})) }
							}
							@input.Input(input.Props{ID: "currency", Name: "currency", Value: currency, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "USD"})), Attributes: templ.Attributes{"required": true}})
						}
						<div class="my-6"></div>
						<h2 class="text-lg font-semibold mb-3">{ Must(t.LocalizeMessage(&i18n.Message{ID: "SpecificationDetails"})) }</h2>
						@tabs.Tabs(tabs.Props{ID: "spec-tabs"}) {
							@tabs.List() {
								@tabs.Trigger(tabs.TriggerProps{Value: "phone", IsActive: specType == "phone"}) {
									{ Must(t.LocalizeMessage(&i18n.Message{ID: "PhoneSpec"})) }
								}
								@tabs.Trigger(tabs.TriggerProps{Value: "pc", IsActive: specType == "pc"}) {
									{ Must(t.LocalizeMessage(&i18n.Message{ID: "PCSpec"})) }
								}
							}
							@tabs.Content(tabs.ContentProps{Value: "phone", IsActive: specType == "phone"}) {
								<div class="pt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
									@form.Item() {
										@form.Label(form.LabelProps{For: "phone_processor"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Processor"})) }
										}
										@input.Input(input.Props{ID: "phone_processor", Name: "phone_processor", Value: phoneProcessor, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "EgA17Pro"}))})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "phone_storage"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Storage"})) }
										}
										@input.Input(input.Props{ID: "phone_storage", Name: "phone_storage", Value: phoneStorage, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg256"})), Attributes: templ.Attributes{"type": "number"}})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "phone_color"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Color"})) }
										}
										@input.Input(input.Props{ID: "phone_color", Name: "phone_color", Value: phoneColor, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "EgNaturalTitanium"}))})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "phone_size"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Size"})) }
										}
										@input.Input(input.Props{ID: "phone_size", Name: "phone_size", Value: phoneSize, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg61Inch"}))})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "phone_camera"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Camera"})) }
										}
										@input.Input(input.Props{ID: "phone_camera", Name: "phone_camera", Value: phoneCamera, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg48MPMain"}))})
									}
								</div>
							}
							@tabs.Content(tabs.ContentProps{Value: "pc", IsActive: specType == "pc"}) {
								<div class="pt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
									@form.Item() {
										@form.Label(form.LabelProps{For: "pc_processor"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Processor"})) }
										}
										@input.Input(input.Props{ID: "pc_processor", Name: "pc_processor", Value: pcProcessor, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "EgIntelCoreI7"}))})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "pc_ram"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "RAM"})) }
										}
										@input.Input(input.Props{ID: "pc_ram", Name: "pc_ram", Value: pcRam, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg16"})), Attributes: templ.Attributes{"type": "number"}})
									}
									@form.Item() {
										@form.Label(form.LabelProps{For: "pc_storage"}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Storage"})) }
										}
										@input.Input(input.Props{ID: "pc_storage", Name: "pc_storage", Value: pcStorage, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg512"})), Attributes: templ.Attributes{"type": "number"}})
									}
								</div>
							}
						}
						<div class="my-6"></div>
						<div class="flex items-center justify-between gap-3">
							<h2 class="text-lg font-semibold">{ Must(t.LocalizeMessage(&i18n.Message{ID: "Prices"})) }</h2>
							@button.Button(button.Props{ID: "prices-add", Variant: button.VariantSecondary, Size: button.SizeSm, Type: button.TypeButton, Attributes: templ.Attributes{
								"_": `on click
									set node to #prices-row-template.content.firstElementChild.cloneNode(true)
									call #prices-rows.appendChild(node)
									set curEl to the first <[data-price-currency]/> in node
									if curEl exists then
										call curEl.focus()
									end
								end`,
							}}) {
								@icon.Plus()
								<span class="ml-2">{ Must(t.LocalizeMessage(&i18n.Message{ID: "Add"})) }</span>
							}
						</div>
						<p class="text-sm text-muted-foreground mt-1">{ Must(t.LocalizeMessage(&i18n.Message{ID: "AmountsAreCents"})) }</p>
						<div id="prices-rows" class="mt-3 space-y-2">
							for _, p := range prices {
								<div data-price-row class="grid grid-cols-12 gap-2 items-end">
									<div class="col-span-5">
										@form.Label(form.LabelProps{For: ""}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "Currency"})) }
										}
										@input.Input(input.Props{Value: p.Currency, Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "USD"})), Attributes: templ.Attributes{"data-price-currency": true, "required": true, "autocomplete": "off", "maxlength": 8, "inputmode": "text", "pattern": "^[A-Za-z]{3,8}$", "title": Must(t.LocalizeMessage(&i18n.Message{ID: "CurrencyMustBe3To8Letters"}))}})
									</div>
									<div class="col-span-6">
										@form.Label(form.LabelProps{For: ""}) {
											{ Must(t.LocalizeMessage(&i18n.Message{ID: "AmountCents"})) }
										}
										@input.Input(input.Props{Value: lo.Ternary(p.Price != 0, fmt.Sprintf("%d", p.Price), ""), Placeholder: Must(t.LocalizeMessage(&i18n.Message{ID: "Eg129900"})), Attributes: templ.Attributes{"data-price-amount": true, "required": true, "type": "number", "step": 1, "min": 0, "inputmode": "numeric"}})
									</div>
									<div class="col-span-1 flex justify-end">
										@button.Button(button.Props{Variant: button.VariantSecondary, Size: button.SizeIcon, Type: button.TypeButton, Attributes: templ.Attributes{"data-price-delete": true, "aria-label": Must(t.LocalizeMessage(&i18n.Message{ID: "DeletePrice"})), "_": `on click
											set rowCount to (<[data-price-row]/> in #prices-rows).length
											if rowCount <= 1 then
												halt the event
											end
											remove the closest <[data-price-row]/>
										end`}}) {
											@icon.Trash()
										}
									</div>
								</div>
							}
						</div>
						<template id="prices-row-template">
							<div data-price-row class="grid grid-cols-12 gap-2 items-end">
								<div class="col-span-5">
									<label class="text-sm leading-none font-medium">{ Must(t.LocalizeMessage(&i18n.Message{ID: "Currency"})) }</label>
									<input data-price-currency required pattern="^[A-Za-z]{3,8}$" title={ Must(t.LocalizeMessage(&i18n.Message{ID: "CurrencyMustBe3To8Letters"})) } autocomplete="off" maxlength="8" inputmode="text" placeholder={ Must(t.LocalizeMessage(&i18n.Message{ID: "USD"})) } class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"/>
								</div>
								<div class="col-span-6">
									<label class="text-sm leading-none font-medium">{ Must(t.LocalizeMessage(&i18n.Message{ID: "AmountCents"})) }</label>
									<input data-price-amount required type="number" step="1" min="0" inputmode="numeric" placeholder={ Must(t.LocalizeMessage(&i18n.Message{ID: "Eg129900"})) } class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"/>
								</div>
								<div class="col-span-1 flex justify-end">
									<button
										type="button"
										data-price-delete
										aria-label={ Must(t.LocalizeMessage(&i18n.Message{ID: "DeletePrice"})) }
										class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 w-9"
										_="on click
											set rowCount to (<[data-price-row]/> in #prices-rows).length
											if rowCount <= 1 then
												halt the event
											end
											remove the closest <[data-price-row]/>
										end"
									>
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
									</button>
								</div>
							</div>
						</template>
						<div class="my-6"></div>
						<div class="flex justify-between gap-3">
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								{ Must(t.LocalizeMessage(&i18n.Message{ID: "Submit"})) }
							}
							if isEditing {
								@button.Button(button.Props{Variant: button.VariantSecondary, Href: apicm.ApiBasePath + "/inventories?sku_id=" + fmt.Sprintf("%d", s.ID)}) {
									{ Must(t.LocalizeMessage(&i18n.Message{ID: "ManageInventory"})) }
								}
							}
						</div>
					</form>
					if isEditing {
						<div class="my-6"></div>
						<h2 class="text-lg font-semibold">{ Must(t.LocalizeMessage(&i18n.Message{ID: "Inventories"})) }</h2>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										{ Must(t.LocalizeMessage(&i18n.Message{ID: "Warehouse"})) }
									}
									@table.Head() {
										{ Must(t.LocalizeMessage(&i18n.Message{ID: "Quantity"})) }
									}
								}
							}
							@table.Body() {
								for _, inv := range s.Inventories {
									@table.Row() {
										@table.Cell() {
											{ inv.Warehouse }
										}
										@table.Cell() {
											{ fmt.Sprintf("%d", inv.Quantity) }
										}
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
